# --- Required -------------------------------------------------------------
# First admin account, created on first run while the admins table is empty.
ADMIN_USER=admin
# At least 12 characters. Leave empty here and set a real value in .env.local / your host's env.
ADMIN_PASSWORD=
# 32+ random characters used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- AI assistant (Gemini) ------------------------------------------------
# API key from https://aistudio.google.com/apikey . Without it the chat still works but answers
# extractively (shows the best matching passage) instead of generating a reply.
GEMINI_API_KEY=
# Defaults shown; override only if you need another model.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Optional -------------------------------------------------------------
# Set to true ONLY behind a reverse proxy that appends the real client IP to X-Forwarded-For
# (nginx, Caddy, Vercel, ...). Never enable it when the Node server is exposed directly.
TRUST_PROXY=false
# SQLite file location (default: ./data/school.db). Needs a persistent disk.
# DATABASE_FILE=
